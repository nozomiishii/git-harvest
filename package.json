{
  "name": "git-harvest",
  "version": "0.3.6",
  "description": "Clean up branches and worktrees",
  "keywords": [
    "branch",
    "cleanup",
    "cli",
    "git",
    "worktree"
  ],
  "homepage": "https://github.com/nozomiishii/git-harvest",
  "license": "MIT",
  "author": "Nozomi Ishii",
  "repository": {
    "type": "git",
    "url": "https://github.com/nozomiishii/git-harvest.git"
  },
  "bin": {
    "git-harvest": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx lib/cli.ts --dry-run",
    "eslint": "eslint --max-warnings=0 --cache",
    "format": "pnpm oxfmt . --check",
    "format:fix": "pnpm oxfmt .",
    "lint": "pnpm eslint",
    "lint:fix": "pnpm eslint --fix",
    "oxfmt": "oxfmt",
    "prepare": "lefthook install --force",
    "prepublishOnly": "pnpm build",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@nozomiishii/commitlint-config": "2.8.1",
    "@nozomiishii/eslint-config": "2.8.1",
    "@nozomiishii/lefthook-config": "2.8.1",
    "@nozomiishii/oxfmt-config": "2.8.1",
    "@nozomiishii/tsconfig": "2.8.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.74.0",
    "release-please": "17.11.2",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "download"
    }
  }
}
